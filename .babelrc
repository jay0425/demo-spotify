{
	"presets": [
		"@babel/preset-env",
		[
			"@babel/preset-react",
			{
				"runtime": "automatic" // 바벨이 리액트 코드를 변환할 때, react를 명시적으로 imoprt 하지 않아도 jsx문법을 사용할 수 있도록 지원합니다. automatic 설정은 최신
			}
		],
		"@babel/preset-typescript"
	],
	"plugins": [
		[
			"@babel/plugin-transform-runtime",
			{
				"regenerator": true // 비동기 코드에서 사용되는 regenerator Runtime을 자동으로 포함합니다.
			}
		]
	]
}

// 브라우저는 js만 안다. 그래서 리액트도 js로 변환되어야 한다.
